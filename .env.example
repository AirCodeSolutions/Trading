TRADING_EXECUTION_MODE=paper
TRADING_DECISION_MODE=confirm
TRADING_LIVE_TRADING_ENABLED=false

TRADING_REFERENCE_CAPITAL_EUR=200
TRADING_RISK_PER_TRADE_FRACTION=0.01
TRADING_ABSOLUTE_MAX_RISK_FRACTION=0.02
TRADING_MAX_DAILY_LOSS_FRACTION=0.03
TRADING_MAX_SPREAD_TO_STOP=0.15
TRADING_MAX_MARGIN_FRACTION=0.25

# Example: /path/to/MetaQuotes/Terminal/<id>/MQL4/Files
TRADING_MT4_FILES_DIR=
TRADING_MT4_SERVER_TIMEZONE=Europe/Athens

# Persistent runtime data outside the source tree.
TRADING_SHADOW_LEDGER_DIR=runtime/shadow
TRADING_MACRO_EVENTS_PATH=runtime/macro_events.json

# Demo execution remains off until the portfolio is qualified.
TRADING_DEMO_EXECUTION_BRIDGE_ENABLED=false
TRADING_DEMO_MAGIC_NUMBER=560619
TRADING_DEMO_MAX_SLIPPAGE_POINTS=100

# First paper evidence compatible with post-PR13 causal entry-bar handling.
TRADING_PAPER_EVIDENCE_CUTOVER_AT=2026-09-20T12:53:56+03:00
